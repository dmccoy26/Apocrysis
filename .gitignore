__pycache__/
*.pyc
.DS_Store

# All runtime-generated state (saves, profiles, play logs, telemetry).
# src/runtime_paths.py routes everything Apocrysis writes at run time
# under this one root - nothing runtime-generated lands in the repo.
.apocrysis/

# Design notes, phase specs, investigation write-ups, session handoffs.
# Working notes for building the game, not the game - kept on disk, out
# of version control.
docs/

# Generated experiment artifacts (tools/scale_report.py output).
tools/*_matrix.json

# Atlas's own tooling output for this project (bugs/decisions/lessons/
# repair history) - not game source, kept out of this repo
memory/
.atlas/
.atlasignore

# Local balance-test output, not source
balance_sweep_out/
graphify-out/
